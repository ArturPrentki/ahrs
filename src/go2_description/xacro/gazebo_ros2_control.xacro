<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Macro for leg interfaces -->
  <xacro:macro name="go2_leg_control_interfaces" params="prefix">
    <joint name="${prefix}_hip_joint">
      <command_interface name="effort"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="${prefix}_thigh_joint">
      <command_interface name="effort"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="${prefix}_calf_joint">
      <command_interface name="effort"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
  </xacro:macro>

  <!-- ros2_control configuration -->
  <ros2_control name="GazeboSimSystem" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>
    <xacro:go2_leg_control_interfaces prefix="FL" />
    <xacro:go2_leg_control_interfaces prefix="FR" />
    <xacro:go2_leg_control_interfaces prefix="RL" />
    <xacro:go2_leg_control_interfaces prefix="RR" />
  </ros2_control>

  <!-- Gazebo plugins -->
  <gazebo>
    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(find go2_description)/config/go2_controllers.yaml</parameters>
      <parameters_from_ros>
          <parameter name="use_sim_time" type="bool">true</parameter>
      </parameters_from_ros>
    </plugin>
  </gazebo>

  <gazebo reference="imu_link">
    <sensor name="imu_sensor" type="imu">
      <always_on>1</always_on>
      <update_rate>1000</update_rate>
      <visualize>true</visualize>
      <topic>imu</topic>
    </sensor>
  </gazebo>

  <gazebo>
    <plugin filename="libgz-sim-imu-system.so" name="gz::sim::systems::Imu"/>
    <plugin filename="libgz-sim-odometry-publisher-system.so" name="gz::sim::systems::OdometryPublisher">
        <odom_frame>odom</odom_frame>
        <robot_base_frame>base</robot_base_frame>
        <odom_publish_frequency>100</odom_publish_frequency>
        <odom_topic>odom</odom_topic>
        <dimensions>3</dimensions>
    </plugin>
    <plugin filename="libgz-sim-joint-state-publisher-system.so" name="gz::sim::systems::JointStatePublisher">
        <topic>joint_states</topic>
    </plugin>
  </gazebo>

</robot>